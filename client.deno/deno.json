{
  "version": "1.0.2",
  "tasks": {
    "dev": "deno run --allow-read --allow-env --allow-net src/main.ts",
    "build_linux": "deno compile --allow-read --allow-env --allow-net --target x86_64-unknown-linux-gnu --output client src/main.ts",
    "build_windows": "deno compile --allow-read --allow-env --allow-net --target x86_64-pc-windows-msvc --output client.exe src/main.ts",
    "build_macos": "deno compile --allow-read --allow-env --allow-net --target aarch64-apple-darwin --output client src/main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@1.0.27",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6"
  },
  "fmt": {
    "include": ["src"],
    "lineWidth": 120,
    "singleQuote": true,
    "semiColons": false,
    "exclude": ["**/*.yaml", "**/*.md"]
  }
}
