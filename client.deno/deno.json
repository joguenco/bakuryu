{
  "version": "1.0.2",
  "tasks": {
    "dev": "deno run --allow-read --allow-env --allow-net main.ts",
    "build": "deno compile --allow-read --allow-env --allow-net main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@1.0.27",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6"
  },
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true,
    "semiColons": false,
    "exclude": ["**/*.yaml", "**/*.md"]
  }
}
